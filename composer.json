{
    "name": "webhubworks/laravel-backup-viewer",
    "description": "A read-only admin page for spatie/laravel-backup: per-target file listings, health status, monitor results, scheduled commands, and notification routing.",
    "keywords": [
        "laravel",
        "backup",
        "spatie",
        "dashboard",
        "admin",
        "webhub"
    ],
    "homepage": "https://github.com/webhubworks/laravel-backup-viewer",
    "license": "MIT",
    "authors": [
        {
            "name": "Marven Thieme",
            "email": "thieme@webhub.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-backup": "^9.0"
    },
    "suggest": {
        "spatie/laravel-backup": "Required for the /backups page to show any data."
    },
    "autoload": {
        "psr-4": {
            "Webhub\\BackupViewer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webhub\\BackupViewer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webhub\\BackupViewer\\BackupViewerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
